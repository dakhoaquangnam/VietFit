{
  "appId": "com.dakhoaquangnam.vietfit",
  "appName": "VietFit",
  "webDir": "dist",
  "backgroundColor": "#ffffff",
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    }
  }
}
